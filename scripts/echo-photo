#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
cli_executable="$repo_dir/src/Echo.Cli/bin/Release/net10.0/echo-photo"
if [[ ! -x "$cli_executable" ]]; then
  dotnet build "$repo_dir/src/Echo.Cli/Echo.Cli.csproj" -c Release --nologo -m:1 >&2
fi
if [[ "$(uname -s)" == "Darwin" && -z "${ECHO_RENDERER:-}" ]]; then
  for argument in "$@"; do
    if [[ "$argument" == "render" ]]; then
      swift build --package-path "$repo_dir/macos" -c release --product EchoRender >&2
      native_bin="$(swift build --package-path "$repo_dir/macos" -c release --show-bin-path)"
      export ECHO_RENDERER="$native_bin/EchoRender"
      break
    fi
  done
fi
exec "$cli_executable" "$@"
