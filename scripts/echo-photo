#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
cli_executable="$repo_dir/src/Echo.Cli/bin/Release/net10.0/echo-photo"
if [[ ! -x "$cli_executable" ]]; then
  dotnet build "$repo_dir/src/Echo.Cli/Echo.Cli.csproj" -c Release --nologo -m:1 >&2
fi
exec "$cli_executable" "$@"
