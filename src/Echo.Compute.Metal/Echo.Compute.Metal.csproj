<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Echo.Compute/Echo.Compute.csproj" />
    <InternalsVisibleTo Include="Echo.Tests" />
    <EmbeddedResource Include="Native/*.metal" />
    <Content Include="obj/$(Configuration)/native/libEchoComputeMetal.dylib" Link="libEchoComputeMetal.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>
  <Target Name="BuildComputeMetalBridge" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Inputs="Native/ComputeBridge.swift;Native/ComputeDevice.swift;Native/ComputeSession.swift;Native/ComputeDescriptorBinding.swift;../../scripts/build-compute-metal.sh" Outputs="obj/$(Configuration)/native/libEchoComputeMetal.dylib">
    <Exec Command="bash ../../scripts/build-compute-metal.sh &quot;obj/$(Configuration)/native&quot;" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>
</Project>
