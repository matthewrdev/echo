<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Echo.Depth/Echo.Depth.csproj" />
    <Content Include="Native/StereoCost.metal" Link="StereoCost.metal" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="obj/$(Configuration)/native/libEchoDepthMetal.dylib" Link="libEchoDepthMetal.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>
  <Target Name="BuildMetalBridge" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Inputs="Native/MetalDepthBridge.swift;Native/MetalDepthSession.swift;../../scripts/build-metal.sh" Outputs="obj/$(Configuration)/native/libEchoDepthMetal.dylib">
    <Exec Command="bash ../../scripts/build-metal.sh &quot;obj/$(Configuration)/native&quot;" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>
</Project>
