<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Echo.Texturing/Echo.Texturing.csproj" />
    <EmbeddedResource Include="Native/TexturePlacement.metal" />
    <Content Include="Native/TexturePlacement.metal" Link="TexturePlacement.metal" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="obj/$(Configuration)/native/libEchoTextureMetal.dylib" Link="libEchoTextureMetal.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>
  <Target Name="BuildTextureMetalBridge" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Inputs="Native/MetalTextureBridge.swift;Native/MetalTextureSession.swift;../../scripts/build-texture-metal.sh" Outputs="obj/$(Configuration)/native/libEchoTextureMetal.dylib">
    <Exec Command="bash ../../scripts/build-texture-metal.sh &quot;obj/$(Configuration)/native&quot;" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>
</Project>
